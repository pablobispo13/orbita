# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# MongoDB (atual). Use MongoDB Atlas (grátis) — precisa de replica set p/ Prisma.
# Ex.: mongodb+srv://user:pass@cluster.mongodb.net/orbita?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASS@CLUSTER.mongodb.net/orbita?retryWrites=true&w=majority"

# Ao migrar para PostgreSQL no futuro, troque provider no schema.prisma e use:
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/orbita?schema=public"

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------
JWT_SECRET="troque-por-um-segredo-forte-e-aleatorio"
# Duração do access token (JWT). A sessão longa vem do refresh token.
ACCESS_TOKEN_TTL="1h"
# Duração do refresh token, em dias.
REFRESH_TOKEN_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# Marca (white-label) — opcional
# ---------------------------------------------------------------------------
# Nome e slogan exibidos na UI. Quem revende o projeto define os seus aqui,
# sem tocar no código. Padrão: "Órbita" / "Gestão multi-empresa".
NEXT_PUBLIC_APP_NAME="Órbita"
NEXT_PUBLIC_APP_TAGLINE="Gestão multi-empresa"

# ---------------------------------------------------------------------------
# Web Push (notificações fora do sistema — Windows/mobile) — opcional
# ---------------------------------------------------------------------------
# Gere o par de chaves com: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY deve ser IGUAL a VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
