# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# MongoDB (atual). Use MongoDB Atlas (grátis) — precisa de replica set p/ Prisma.
# Ex.: mongodb+srv://user:pass@cluster.mongodb.net/orbita?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASS@CLUSTER.mongodb.net/orbita?retryWrites=true&w=majority"

# Ao migrar para PostgreSQL no futuro, troque provider no schema.prisma e use:
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/orbita?schema=public"

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------
JWT_SECRET="troque-por-um-segredo-forte-e-aleatorio"
